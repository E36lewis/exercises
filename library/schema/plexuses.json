{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "branch": {
      "enum": [
        "no_branch",
        "supraclavicular",
        "child_branch"
      ]
    },
    "division": {
      "enum": [
        "no_division",
        "anterior",
        "posterior"
      ]
    },
    "id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "trunk": {
      "enum": [
        "no_trunk",
        "middle",
        "inferior",
        "superior"
      ]
    }
  },
  "required": [
    "id",
    "name",
    "trunk",
    "division",
    "branch"
  ],
  "title": "The front matter of a file in library/plexuses/",
  "type": "object"
}
